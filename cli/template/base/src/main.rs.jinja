use boutique::Server;
{% if database %}
use sea_orm::Database;
use sea_orm_migration::MigratorTrait;
{% endif %}
use tracing_subscriber::EnvFilter;

use crate::{config::Config, state::AppState};

async fn serve(state: AppState) {
    let address = format!("0.0.0.0:{}", state.config.port);
    let served = Server::new()
        .debug(cfg!(debug_assertions))
        .file("/robots.txt", "public/robots.txt")
        .error_page(boutique::views::error_page)
        .serve(router::create(state), address)
        .await;

    if let Err(error) = served {
        tracing::error!(%error, "the server stopped");
        std::process::exit(1);
    }
}

#[tokio::main]
async fn main() {
    dotenvy::dotenv().ok();
    tracing_subscriber::fmt()
        .with_env_filter(EnvFilter::try_from_default_env().unwrap_or_else(|_| EnvFilter::new("info")))
        .init();

    let config = Config::from_env();
{% if database %}
    let db = Database::connect(&config.database_url).await.expect("could not connect to the database");
    migrations::Migrator::up(&db, None).await.expect("could not run the migrations");
    let state = AppState::new(config, db);
{% else %}
    let state = AppState::new(config);
{% endif %}

    tracing::info!("listening on http://localhost:{}", state.config.port);
    boutique::run(state, serve).await;
}
